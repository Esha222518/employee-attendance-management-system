PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/attendance_system
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Standard working hours per day (used for working-hours / leave-deduction calc)
STANDARD_WORK_HOURS=8

# Monthly gross salary used for demo leave-deduction calculation (per employee override possible in DB)
DEFAULT_MONTHLY_SALARY=30000

# Paid leaves allowed per month before deduction kicks in
PAID_LEAVES_PER_MONTH=2
